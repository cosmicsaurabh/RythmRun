# Database Configuration
# Use a managed PostgreSQL service like Neon, Supabase, or Railway.
# Prisma CLI configuration and the runtime PrismaPg adapter both read this URL.
# The optional schema query parameter is passed to the Prisma adapter.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Pool size and connection/idle timeouts are defined in src/config/database.ts.
# For production, follow the database provider's TLS/CA requirements and keep
# the credential in the deployment secret store. CI's dummy URL is sufficient
# for validation, generation, compilation, and the no-DB runtime smoke only; it
# does not prove connectivity, migrations, TLS, pooling, or transactions.
DATABASE_URL="REPLACE_WITH_DATABASE_URL"

# JWT Authentication Secrets
# Generate secure random strings using: openssl rand -base64 32
JWT_SECRET="your-secret-key-here-minimum-32-characters-long"
REFRESH_TOKEN_SECRET="your-refresh-secret-key-here-minimum-32-characters-long"

# Google OAuth web/server client ID. Use this exact value as Flutter's
# GOOGLE_SERVER_CLIENT_ID so the ID-token audience matches on both sides.
GOOGLE_SERVER_CLIENT_ID="REPLACE_WITH_GOOGLE_SERVER_CLIENT_ID"

# Server Configuration
PORT=8080
NODE_ENV=development

# CORS Configuration (optional - for production, specify your frontend domain)
# CORS_ORIGIN=https://your-frontend-domain.com

# Cloudflare R2 Configuration
# Get these from your Cloudflare R2 dashboard: https://dash.cloudflare.com/
R2_ACCOUNT_ID="your-account-id"
R2_ACCESS_KEY_ID="your-access-key-id"
R2_SECRET_ACCESS_KEY="your-secret-access-key"
R2_BUCKET_AVATARS="rythmrun-avatars"
R2_BUCKET_ACTIVITY_IMAGES="rythmrun-activity-images"
R2_PUBLIC_URL="https://your-account-id.r2.cloudflarestorage.com"

# Email Verification (OPTIONAL feature group)
# ----------------------------------------------------------------------------
# Unlike the variables above, these are NOT fail-closed: leave the whole group
# unset and the server still boots with email delivery disabled (verification
# links are simply never sent). But set ANY of them and ALL of the required
# ones must be present -- a half-configured mailer is worse than none.
#
# Required when enabled: SMTP_HOST, SMTP_USER, SMTP_PASS, MAIL_FROM,
# PUBLIC_APP_URL. Optional: SMTP_PORT (default 587), SMTP_SECURE (default
# false).
#
# Left commented out so the feature is OFF by default and the server boots.
# Uncomment the whole block and fill in real values to enable it.
#
# Values below target Brevo's free SMTP relay (300 emails/day, no card).
# SMTP_PASS is the SMTP key from Brevo's "SMTP & API" page -- NOT your
# account password.
#SMTP_HOST="smtp-relay.brevo.com"
#SMTP_PORT=587
# false = STARTTLS on port 587 (the connection is still upgraded to TLS).
# Set true only when using implicit TLS on port 465.
#SMTP_SECURE=false
#SMTP_USER="your-smtp-login"
#SMTP_PASS="your-smtp-key"
#
# Must be a sender address you have verified with the provider (single-sender
# verification, or any address on a domain you authenticated with SPF/DKIM).
#MAIL_FROM="RythmRun <noreply@your-domain.com>"
#
# Public origin used to build the verification link that is emailed to users.
# Must be an absolute http(s) URL; a trailing slash is normalized away. This is
# the backend's own public origin, e.g. https://rythmrun.onrender.com, because
# the verification page is served by this API at /api/users/verify-email.
# Never derive this from the request Host header: a spoofed host would send
# users a poisoned verification link.
#PUBLIC_APP_URL="https://your-api-host.example.com"

# For local development, point the same variables at a capture-only inbox
# (e.g. Mailtrap's sandbox) so no real mail is ever delivered:
#   SMTP_HOST="sandbox.smtp.mailtrap.io"
#   PUBLIC_APP_URL="http://localhost:8080"
