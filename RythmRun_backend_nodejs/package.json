{
  "name": "rythmrun_backend_nodejs",
  "version": "1.0.0",
  "description": "",
  "main": "dist/main.js",
  "scripts": {
    "dev": "nodemon --watch src --watch prisma --ext ts,prisma --exec \"npm run build && node --enable-source-maps dist/main.js\"",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && prisma generate && tsc -p tsconfig.json",
    "start": "node --enable-source-maps dist/main.js",
    "smoke:runtime": "node scripts/smoke-built-runtime.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate:deploy": "prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "seed": "npm run build && node --enable-source-maps dist/utils/seedData.js",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1085.0",
    "@aws-sdk/s3-presigned-post": "^3.1085.0",
    "@aws-sdk/s3-request-presigner": "^3.1085.0",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "8.22.0",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "22.20.1",
    "@types/pg": "8.20.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "prisma": "7.8.0",
    "ts-jest": "^29.4.11",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@hono/node-server": "^1.19.13"
  }
}
