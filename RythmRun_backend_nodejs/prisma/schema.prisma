generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  Int                  @id @default(autoincrement())
  firstname           String?
  lastname            String?
  username            String               @unique
  password            String?
  googleSubject       String?              @unique @db.VarChar(255)
  emailVerified       Boolean              @default(false)
  profilePicturePath  String?
  profilePictureType  String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @default(now()) @updatedAt
  activities          Activity[]
  activityImages      ActivityImage[]
  avatarUploadIntents AvatarUploadIntent[]
  comments            Comment[]
  friendsAsUser1      Friend[]             @relation("UserFriends")
  friendsAsUser2      Friend[]             @relation("UserFriends2")
  likes               Like[]
  authSessions        AuthSession[]
  verificationTokens  VerificationToken[]
}

enum VerificationTokenPurpose {
  EMAIL_VERIFICATION
}

// Single-use, hash-at-rest capability tokens delivered by email. Only the
// SHA-256 digest is stored (mirrors RefreshTokenRecord.tokenDigest); the raw
// token lives only in the emailed link. The @@unique([userId, purpose])
// constraint keeps exactly one outstanding token per user per purpose, so a
// resend rotates the previous token instead of accumulating live secrets.
model VerificationToken {
  id          String                   @id @default(cuid())
  userId      Int
  purpose     VerificationTokenPurpose @default(EMAIL_VERIFICATION)
  tokenDigest String                   @unique @db.Char(64)
  expiresAt   DateTime
  consumedAt  DateTime?
  lastSentAt  DateTime?
  createdAt   DateTime                 @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, purpose])
  @@index([expiresAt])
}

model AvatarUploadIntent {
  id                 String    @id @default(cuid())
  userId             Int
  key                String    @unique
  contentType        String
  sizeBytes          Int
  expiresAt          DateTime
  consumedAt         DateTime?
  cleanupKey         String?
  cleanupCompletedAt DateTime?
  createdAt          DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, consumedAt, expiresAt])
  @@index([consumedAt, expiresAt])
  @@index([cleanupCompletedAt, consumedAt])
}

model Activity {
  id             Int             @id @default(autoincrement())
  userId         Int
  clientSyncId   String
  metricsVersion Int             @default(1)
  type           String          @db.VarChar(50)
  startTime      DateTime
  endTime        DateTime
  distance       Float
  duration       Int
  avgSpeed       Float
  maxSpeed       Float
  calories       Int?
  description    String?
  isPublic       Boolean         @default(true)
  pausedDuration Int?
  name           String?
  elevationGain  Float?
  elevationLoss  Float?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @default(now()) @updatedAt
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments       Comment[]
  likes          Like[]
  locations      Location[]
  statusChanges  StatusChange[]
  images         ActivityImage[]

  @@unique([userId, clientSyncId])
}

model ActivityImage {
  id             Int                 @id @default(autoincrement())
  activityId     Int
  userId         Int
  clientImageId  String
  s3Key          String              @unique
  contentType    String
  sizeBytes      Int
  checksumSha256 String?
  width          Int?
  height         Int?
  sortOrder      Int                 @default(0)
  caption        String?
  status         ActivityImageStatus @default(PENDING_UPLOAD)
  uploadedAt     DateTime?
  deletedAt      DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @default(now()) @updatedAt

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([activityId, clientImageId])
  @@index([activityId, sortOrder])
  @@index([userId])
  @@index([status])
}

enum ActivityImageStatus {
  PENDING_UPLOAD
  UPLOADED
  DELETE_PENDING
  DELETED
  FAILED
}

model Location {
  id         Int      @id @default(autoincrement())
  activityId Int
  latitude   Float
  longitude  Float
  altitude   Float?
  timestamp  DateTime
  accuracy   Float?
  speed      Float?
  heading    Float?
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
}

model StatusChange {
  id         Int      @id @default(autoincrement())
  activityId Int
  status     String   @db.VarChar(20)
  timestamp  DateTime
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
}

model Comment {
  id         Int      @id @default(autoincrement())
  activityId Int
  userId     Int
  content    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Like {
  id         Int      @id @default(autoincrement())
  activityId Int
  userId     Int
  createdAt  DateTime @default(now())
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([activityId, userId])
}

model Friend {
  id        Int      @id @default(autoincrement())
  user1Id   Int
  user2Id   Int
  status    String   @db.VarChar(20)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  user1     User     @relation("UserFriends", fields: [user1Id], references: [id], onDelete: Cascade)
  user2     User     @relation("UserFriends2", fields: [user2Id], references: [id], onDelete: Cascade)

  @@unique([user1Id, user2Id])
}

enum AuthSessionStatus {
  ACTIVE
  REVOKED
}

model AuthSession {
  id            String               @id @db.Uuid
  userId        Int
  familyId      String               @unique @db.Uuid
  status        AuthSessionStatus    @default(ACTIVE)
  createdAt     DateTime             @default(now())
  lastUsedAt    DateTime             @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshTokenRecord[]

  @@index([userId, status, expiresAt])
  @@index([familyId, status])
  @@index([status, expiresAt])
  @@index([expiresAt])
}

model RefreshTokenRecord {
  jti           String              @id @db.Uuid
  sessionId     String              @db.Uuid
  tokenDigest   String              @unique @db.Char(64)
  issuedAt      DateTime            @default(now())
  expiresAt     DateTime
  usedAt        DateTime?
  revokedAt     DateTime?
  replacedByJti String?             @unique @db.Uuid
  session       AuthSession         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  replacedBy    RefreshTokenRecord? @relation("RefreshRotation", fields: [replacedByJti], references: [jti], onDelete: SetNull)
  replaces      RefreshTokenRecord? @relation("RefreshRotation")

  @@index([sessionId, usedAt, revokedAt])
  @@index([expiresAt])
}
